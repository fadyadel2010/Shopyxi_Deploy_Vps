                "resources": {
                  "requests": {
                    "cpu": "25m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "250m",
                    "memory": "128Mi"
                  }
                }
              }
            ],
            "volumes": [
              {
                "name": "nginx",
                "configMap": {
                  "name": "shopixy-web-nginx",
                  "defaultMode": 292
                }
              },
              {
                "name": "temporary",
                "emptyDir": {
                  "sizeLimit": "128Mi"
                }
              }
            ],
            "nodeSelector": {
              "kubernetes.io/hostname": "shopixy"
            }
          }
        }
