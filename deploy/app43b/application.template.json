                    "name": "nginx",
                    "mountPath": "/etc/nginx/nginx.conf",
                    "subPath": "nginx.conf",
                    "readOnly": true
                  },
                  {
                    "name": "temporary",
                    "mountPath": "/tmp"
                  }
