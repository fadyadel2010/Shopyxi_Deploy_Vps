{
  "name": "pointofsale-whatsapp-baileys",
  "version": "1.0.0",
  "description": "Baileys-based WhatsApp microservice for PointOfSale system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "node --watch --require ts-node/register src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run --testNamePattern='Property' --reporter=verbose",
    "test:unit": "vitest run --testNamePattern='Unit' --reporter=verbose",
    "test:types": "tsc --project tsconfig.test.json --noEmit"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "microservice"
  ],
  "author": "PointOfSale Team",
  "license": "MIT",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@types/uuid": "^10.0.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.3",
    "redis": "6.3.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "fast-check": "^3.15.0",
    "@vitest/coverage-v8": "4.1.12",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
